# 首次启动必填。管理员只创建一次；之后通过工作台修改密码。
BAITE_ADMIN_USERNAME=admin
BAITE_ADMIN_PASSWORD=replace-with-a-long-password
BAITE_SESSION_SECRET=replace-with-at-least-24-random-characters

# 生产环境请使用绝对路径和 HTTPS 公网地址。
BAITE_DB_PATH=/absolute/path/to/baite.db
BAITE_PUBLIC_URL=http://127.0.0.1:8000
BAITE_COOKIE_SECURE=false
BAITE_HOST=127.0.0.1
BAITE_PORT=8000

# Selected RAG 唯一正式来源；代码不维护固定文件清单。
BAITE_SELECTED_RAG_FOLDER_TOKEN=KQjyf6KrxlZ24MdkHirc9TP0n2d
BAITE_TIMEZONE=Asia/Shanghai

# 可选。
BAITE_SESSION_HOURS=12
BAITE_ONLINE_WINDOW_SECONDS=10

# 仅用于隔离自动化测试；正式运行不要开启。
# BAITE_DISABLE_EXTERNAL_SYNC=true
