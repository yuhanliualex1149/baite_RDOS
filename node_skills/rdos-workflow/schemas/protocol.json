{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDOS business result",
  "type": "object",
  "required": ["protocol_version", "workspace_id", "project_id", "id", "operation_id", "claimed_node_id", "event_type", "task_refs", "body"],
  "properties": {
    "protocol_version": {"const": 2},
    "workspace_id": {"type": "string"},
    "project_id": {"type": "string"},
    "id": {"type": "string"},
    "operation_id": {"type": "string"},
    "claimed_node_id": {"type": "string"},
    "event_type": {"enum": ["submission", "review", "check_result", "progress", "blocker", "clarification", "correction", "paused_ack", "closed_ack"]},
    "result_status": {"enum": ["completed", "partial", "blocked"]},
    "task_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["task_id", "requirements_version"]}},
    "artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/documentVersion"}},
    "review_of": {"$ref": "#/$defs/documentVersion"},
    "body": {"type": "string", "minLength": 1}
  },
  "$defs": {"documentVersion": {"type": "object", "required": ["document_id", "revision", "content_hash"], "properties": {"document_id": {"type": "string"}, "revision": {"type": ["integer", "string"]}, "content_hash": {"type": "string"}}}}
}
