# Copy as /etc/baite-rdos/rdos2.env (root:root 0600) after reviewing the
# existing /etc/baite-rdos/rdos.env.  Existing secrets stay in that file.
RDOS_RUNTIME_MODE=production
BAITE_PUBLIC_URL=https://yjmt.cn/baite-rdos
BAITE_DB_PATH=/var/lib/baite-rdos/baite.db
BAITE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
BAITE_LLM_MODEL=deepseek-v4-pro
BAITE_LLM_THINKING=enabled
BAITE_LLM_REASONING_EFFORT=high
RDOS_MAINTENANCE_ENABLED=0
