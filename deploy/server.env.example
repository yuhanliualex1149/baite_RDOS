BAITE_DB_PATH=/var/lib/baite-rdos/baite.db
BAITE_PUBLIC_URL=https://yjmt.cn/baite-rdos
BAITE_SESSION_SECRET=GENERATE_A_NEW_RANDOM_SECRET
BAITE_ADMIN_USERNAME=shared_admin
BAITE_ADMIN_PASSWORD=GENERATE_A_NEW_RANDOM_PASSWORD
BAITE_COOKIE_SECURE=true
BAITE_SESSION_HOURS=12
BAITE_ONLINE_WINDOW_SECONDS=60
BAITE_TIMEZONE=Asia/Shanghai
BAITE_BOOTSTRAP_MANIFEST_PATH=/opt/baite-rdos/downloads/manifest.json
BAITE_SELECTED_RAG_FOLDER_TOKEN=SET_THE_APPROVED_SOURCE_FOLDER
BAITE_DISABLE_EXTERNAL_SYNC=true
