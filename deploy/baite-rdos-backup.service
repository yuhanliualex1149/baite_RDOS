[Unit]
Description=Baite RDOS consistent local backup

[Service]
Type=oneshot
User=baite-rdos
Group=baite-rdos
WorkingDirectory=/opt/baite-rdos/current
EnvironmentFile=/etc/baite-rdos/rdos.env
EnvironmentFile=/opt/baite-rdos/current/release.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/baite-rdos/current/.venv/bin/python -m server.backup --directory /var/lib/baite-rdos/backups --retain-days 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/baite-rdos
